+
+/* Paper-out recovery. Worked out on a real LBP2900 with tools/capt-probe.py
+ * (04.09.2026) and the Canon Windows driver capture (HighwayStar, 2013):
+ *  - the printer drops the fired page, sets UNINIT2 (and NOPAPER if its sensor
+ *    saw the empty tray) and sooner or later releases the unit on its own
+ *    (STATUS0 bit 0); from then on every command but status polls answers
+ *    0x88, and page data pushed in that state hangs the printer until a
+ *    power cycle (USB resets don't help);
+ *  - ReserveUnit answers 0x87 while the unit is still held, 0x90 for the
+ *    byte-0 = 0x02 variant Windows uses, 0x00 for the plain variant;
+ *  - plain ReserveUnit -> JOB_SETUP -> START_1/2/3 -> UPLOAD_2 brings it back
+ *    (UNINIT clears, page counters restart from 0) and the page prints;
+ *  - the button is only reported while the LED blinks.
+ * Never send page data unless every step here was accepted and the flags are
+ * clear; when the printer can't be re-acquired, fail the job instead. */
+static void lbp2900_release_and_reacquire(struct printer_state_s *state)
+{
+	const struct capt_status_s *status = lbp2900_get_status(state->ops);
+	uint8_t buf[8];
+	size_t size;
+
+	if (! FLAG(status, CAPT_FL_NOJOB)) {
+		uint8_t jbuf[2] = { LO(job), HI(job) };
+		fprintf(stderr, "DEBUG: CAPT: paper-out recovery: releasing job %u\n", job);
+		capt_sendrecv(CAPT_JOB_END, jbuf, 2, NULL, 0);
+		sleep(1);
+	}
+
+	/* ReserveUnit answers 0x90 while the printer runs its own paper check
+	 * (~10 s on an LBP2900, repeated every ~15 s while the tray stays empty),
+	 * 0x87 while a job still holds it. Wait the 0x90 out: the job is
+	 * "waiting for paper", which is what the queue shows. */
+	fprintf(stderr, "DEBUG: CAPT: paper-out recovery: re-acquiring the printer\n");
+	capt_expect_reject = true;
+	for (unsigned tries = 0, other = 0; ; ++tries) {
+		size = sizeof(buf);
+		capt_sendrecv(CAPT_JOB_BEGIN, magicbuf_0, ARRAY_SIZE(magicbuf_0), buf, &size);
+		if (capt_last_result == 0) {
+			job = WORD(buf[2], buf[3]);
+			break;
+		}
+		if (capt_last_result == 0x90) {
+			if (tries == 0)
+				fprintf(stderr, "DEBUG: CAPT: printer busy with its own recovery (ReserveUnit -> 0x90), waiting\n");
+			else if (tries % 30 == 0)
+				fprintf(stderr, "DEBUG: CAPT: still waiting for the printer (ReserveUnit -> 0x90, %us)\n", tries);
+		} else if (capt_last_result == 0x87) {
+			uint8_t jbuf[2] = { LO(job), HI(job) };
+			fprintf(stderr, "DEBUG: CAPT: unit still held (0x87), releasing job %u again\n", job);
+			capt_sendrecv(CAPT_JOB_END, jbuf, 2, NULL, 0);
+		} else if (++other >= 10) {
+			fprintf(stderr, "ERROR: CAPT: printer refuses to restart the job (result 0x%02X); switch it off and on\n",
+					capt_last_result);
+			exit(1);
+		}
+		sleep(1);
+		lbp2900_get_status(state->ops);   /* keep the status trail in the log while waiting */
+	}
+	capt_expect_reject = false;
+	fprintf(stderr, "DEBUG: CAPT: paper-out recovery: job %u, re-initialising the engine\n", job);
+
+	send_job_start(2, 0);
+	capt_sendrecv(CAPT_START_1, NULL, 0, NULL, 0);
+	capt_sendrecv(CAPT_START_2, NULL, 0, NULL, 0);
+	capt_sendrecv(CAPT_START_3, NULL, 0, NULL, 0);
+	lbp2900_wait_ready(state->ops);
+	capt_sendrecv(CAPT_UPLOAD_2, magicbuf_2, ARRAY_SIZE(magicbuf_2), NULL, 0);
+	if (capt_last_result != 0) {
+		fprintf(stderr, "ERROR: CAPT: printer refuses re-initialisation (result 0x%02X); switch it off and on\n",
+				capt_last_result);
+		exit(1);
+	}
+	lbp2900_wait_ready(state->ops);
+
+	/* Show it at the machine: the LED blinks until a page actually comes out. */
+	if (! lbp2900_led_blinking) {
+		capt_sendrecv(CAPT_GPIO, lbp2900_gpio_blink, ARRAY_SIZE(lbp2900_gpio_blink), NULL, 0);
+		lbp2900_led_blinking = capt_last_result == 0;
+	}
+}
+
+static void lbp2900_recover_paper_out(struct printer_state_s *state)
+{
+	const struct capt_status_s *status;
+
+	fprintf(stderr, "INFO: CAPT: out of paper: load paper (the printer retries by itself)\n");
+	lbp2900_release_and_reacquire(state);
+
+	while (1) {
+		status = lbp2900_get_status(state->ops);
+		if (! FLAG(status, CAPT_FL_NOPAPER1) && ! FLAG(status, CAPT_FL_NOPAPER2)
+				&& ! FLAG(status, CAPT_FL_UNINIT1) && ! FLAG(status, CAPT_FL_UNINIT2))
+			break;
+
+		/* The flags survived the reset: this firmware wants the button. */
+		fprintf(stderr, "INFO: CAPT: load paper and press the printer button\n");
+		if (! lbp2900_led_blinking) {
+			capt_sendrecv(CAPT_GPIO, lbp2900_gpio_blink, ARRAY_SIZE(lbp2900_gpio_blink), NULL, 0);
+			lbp2900_led_blinking = true;
+		}
+		lbp2900_wait_ready(state->ops);
+		capt_sendrecv(CAPT_LBP3000_SETUP_0, lbp2900_offline, ARRAY_SIZE(lbp2900_offline), NULL, 0); /* GoOffline */
+
+		lbp2900_wait_button(state);
+
+		capt_sendrecv(CAPT_GPIO, lbp2900_gpio_init, ARRAY_SIZE(lbp2900_gpio_init), NULL, 0);
+		lbp2900_led_blinking = false;
+		lbp2900_wait_ready(state->ops);
+		fprintf(stderr, "DEBUG: CAPT: paper-out recovery: re-initialising after the button\n");
+		lbp2900_release_and_reacquire(state);
+	}
+
+	/* media-empty stays on until page_epilogue sees the page come out */
+	lbp2900_page_dropped = false;
+}
+
+static void lbp2900_wait_user(struct printer_state_s *state)
+{
+	if (lbp2900_page_dropped) {
+		lbp2900_recover_paper_out(state);
+		return;
+	}
+
+	fprintf(stderr, "INFO: CAPT: press the printer button to continue\n");
+	capt_sendrecv(CAPT_GPIO, lbp2900_gpio_blink, ARRAY_SIZE(lbp2900_gpio_blink), NULL, 0);
+	lbp2900_wait_ready(state->ops);
+
+	lbp2900_wait_button(state);
 
 	capt_sendrecv(CAPT_GPIO, lbp2900_gpio_init, ARRAY_SIZE(lbp2900_gpio_init), NULL, 0);
 	lbp2900_wait_ready(state->ops);
