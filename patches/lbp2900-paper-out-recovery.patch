+/* 8-bit grey line y -> packed 1-bit line (1 = black). `black255` says whether
+ * 255 means black (CUPS_CSPACE_K) or white (CUPS_CSPACE_W/SW). `block` > 1
+ * averages block x block pixels first: the fallback for pages that would not
+ * fit into the printer's memory (noise does not compress; averaging removes it). */
+static void dither_line(uint8_t *packed, size_t packed_size,
+		const uint8_t *page, unsigned bpl, unsigned width, unsigned height, unsigned y,
+		bool black255, unsigned block)
 {
+	const uint8_t *line = page + (size_t) y * bpl;
+	memset(packed, 0, packed_size);
+	for (unsigned x = 0; x < width; ++x) {
+		unsigned v;
+		if (block > 1) {
+			unsigned x0 = x - x % block, y0 = y - y % block, sum = 0, n = 0;
+			for (unsigned yy = y0; yy < y0 + block && yy < height; ++yy)
+				for (unsigned xx = x0; xx < x0 + block && xx < width; ++xx) {
+					sum += page[(size_t) yy * bpl + xx];
+					++n;
+				}
+			v = (sum + n / 2) / n;
+		} else {
+			v = line[x];
+		}
+		if (! black255)
+			v = 255 - v;
+		/* v = blackness 0..255; threshold from the 64-level matrix */
+		if (v > (unsigned) bayer8[y & 7][x & 7] * 4 + 1)
+			packed[x >> 3] |= 0x80 >> (x & 7);
+	}
