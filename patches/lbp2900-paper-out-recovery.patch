+/* Hi-SCoA bytes per page we allow ourselves out of the printer's 2 MB. Above
+ * PAGE_BUDGET the page is halftoned again at half detail (2x2 averaging);
+ * above PAGE_LIMIT it is refused: data that does not fit garbles the print
+ * and hangs the printer until a power cycle. */
+#define PAGE_BUDGET (1280u * 1024u)
+#define PAGE_LIMIT  (1536u * 1024u)
