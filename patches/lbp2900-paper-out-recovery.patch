+/* START_1/2/3 + UPLOAD_2: (re)initialise the engine. UPLOAD_2 also resets the
+ * page counters in the status record and drops a page held in the printer. */
+static void lbp2900_reset(struct printer_state_s *state)
+{
+	capt_sendrecv(CAPT_START_1, NULL, 0, NULL, 0);
+	capt_sendrecv(CAPT_START_2, NULL, 0, NULL, 0);
+	capt_sendrecv(CAPT_START_3, NULL, 0, NULL, 0);
+	lbp2900_wait_ready(state->ops);
+	capt_sendrecv(CAPT_UPLOAD_2, magicbuf_2, ARRAY_SIZE(magicbuf_2), NULL, 0);
+	lbp2900_wait_ready(state->ops);
+}
+
+/* Page data sender that honours STATUS0 bit 2 "buffer full: do not send data"
+ * (SPECS 1.3). The generic sender only waits for BUSY every 16 packets; a text
+ * page (~25 KB) never fills the LBP2900's buffer, but a photo page (several MB
+ * of Hi-SCoA data) does, and the printer then garbles or drops the page. */
+static void lbp2900_send_band(struct printer_state_s *state, const void *data, size_t size)
+{
+	static size_t since_poll = 0;   /* bytes sent since the last buffer check */
+	const uint8_t *pdata = (const uint8_t *) data;
+	while (size) {
+		size_t send = 0xFF00;
+		if (send > size)
+			send = size;
+		if (since_poll + send > 32768) {
+			for (unsigned polls = 0; ; ++polls) {
+				const struct capt_status_s *status = lbp2900_get_status(state->ops);
+				if (! FLAG(status, CAPT_FL_BUFFERFULL) && ! FLAG(status, CAPT_FL_BUSY))
+					break;
+				if (polls >= 10 * CAPT_WAIT_POLLS_PAGE) {
+					fprintf(stderr, "WARNING: CAPT: buffer stayed full ~%us while sending page data; proceeding\n",
+							polls / 10);
+					break;
+				}
+				usleep(CAPT_POLL_US);
+			}
+			since_poll = 0;
+		}
+		since_poll += send;
+		capt_send(CAPT_PRINT_DATA, pdata, send);
+		pdata += send;
+		size -= send;
+	}
+}
