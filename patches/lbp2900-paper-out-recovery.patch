+/* Ordered dither, 8x8 Bayer, 64 levels. The LBP2900 has 2 MB of memory and
+ * no way to add more; Hi-SCoA was designed for the regular screens of Canon's
+ * own driver. Apple's cgpdftoraster halftones with error diffusion, which
+ * Hi-SCoA cannot compress (a photo page came out at 3.7 MB, printed as a
+ * collage of strips and hung the printer), so we ask it for 8-bit grey and
+ * halftone here with a regular matrix: the same page is 0.7 MB. */
+static const uint8_t bayer8[8][8] = {
+	{  0, 32,  8, 40,  2, 34, 10, 42 }, { 48, 16, 56, 24, 50, 18, 58, 26 },
+	{ 12, 44,  4, 36, 14, 46,  6, 38 }, { 60, 28, 52, 20, 62, 30, 54, 22 },
+	{  3, 35, 11, 43,  1, 33,  9, 41 }, { 51, 19, 59, 27, 49, 17, 57, 25 },
+	{ 15, 47,  7, 39, 13, 45,  5, 37 }, { 63, 31, 55, 23, 61, 29, 53, 21 },
+};
