+/* Paper-out recovery, modelled on a USB capture of the Canon Windows driver
+ * on an LBP2900 (HighwayStar, linux.org.ru, 2013). The printer drops the fired
+ * page, latches NOPAPER/UNINIT and answers every further command with an
+ * error code (0x87 to ReserveUnit, 0x88 to the rest) until the job is
+ * released and the engine re-initialised; pushing page data into it in that
+ * state stalls the USB link. Windows does:
+ *   JOB_SETUP fg=6 (already sent by page_epilogue) -> JOB_END (ReleaseUnit)
+ *   -> poll -> JOB_BEGIN with byte 0 = 0x02 (ReserveUnit) -> JOB_SETUP fg=2
+ *   -> START_1/2/3 + UPLOAD_2 -> GPIO blink -> GoOffline -> wait for button
+ *   -> GPIO init -> JOB_SETUP -> START_1/2/3 + UPLOAD_2 -> re-send the page.
+ * The caller keeps the job open and re-sends the same page afterwards. */
+static void lbp2900_recover_paper_out(struct printer_state_s *state)
+{
+	uint8_t jbuf[2] = { LO(job), HI(job) };
+	uint8_t buf[8];
+	size_t size = sizeof(buf);
+	const struct capt_status_s *status;
+
+	fprintf(stderr, "INFO: CAPT: load paper and press the printer button\n");
+	fprintf(stderr, "DEBUG: CAPT: paper-out recovery: releasing job %u\n", job);
+	capt_sendrecv(CAPT_JOB_END, jbuf, 2, NULL, 0);
+
+	/* let the engine settle; the Canon driver polls for several seconds here */
+	sleep(1);
+	for (unsigned polls = 0; polls < CAPT_WAIT_POLLS_PAGE; ++polls) {
+		status = lbp2900_get_status(state->ops);
+		if (! FLAG(status, CAPT_FL_PROCESSING1) && ! FLAG(status, CAPT_FL_PRINTING))
+			break;
+		usleep(CAPT_POLL_US);
+	}
+
+	fprintf(stderr, "DEBUG: CAPT: paper-out recovery: re-acquiring the printer\n");
+	capt_sendrecv(CAPT_JOB_BEGIN, magicbuf_0_recover, ARRAY_SIZE(magicbuf_0_recover), buf, &size);
+	if (size >= 4)
+		job = WORD(buf[2], buf[3]);
+	send_job_start(2, 0);
+	lbp2900_reset(state);
+
+	capt_sendrecv(CAPT_GPIO, lbp2900_gpio_blink, ARRAY_SIZE(lbp2900_gpio_blink), NULL, 0);
+	lbp2900_wait_ready(state->ops);
+	capt_sendrecv(CAPT_LBP3000_SETUP_0, lbp2900_offline, ARRAY_SIZE(lbp2900_offline), NULL, 0); /* GoOffline */
+
+	lbp2900_wait_button(state);
+
+	capt_sendrecv(CAPT_GPIO, lbp2900_gpio_init, ARRAY_SIZE(lbp2900_gpio_init), NULL, 0);
+	lbp2900_wait_ready(state->ops);
+	send_job_start(2, 0);
+	fprintf(stderr, "DEBUG: CAPT: paper-out recovery: re-initialising the engine\n");
+	lbp2900_reset(state);
+
+	status = lbp2900_get_status(state->ops);
+	if (FLAG(status, CAPT_FL_NOPAPER1) || FLAG(status, CAPT_FL_NOPAPER2))
+		fprintf(stderr, "WARNING: CAPT: printer still reports no paper after recovery\n");
+	lbp2900_page_dropped = false;
+}
+
+static void lbp2900_wait_user(struct printer_state_s *state)
+{
+	if (lbp2900_page_dropped) {
+		lbp2900_recover_paper_out(state);
+		return;
+	}
+
+	fprintf(stderr, "INFO: CAPT: press the printer button to continue\n");
+	capt_sendrecv(CAPT_GPIO, lbp2900_gpio_blink, ARRAY_SIZE(lbp2900_gpio_blink), NULL, 0);
+	lbp2900_wait_ready(state->ops);
+
+	lbp2900_wait_button(state);
 
 	capt_sendrecv(CAPT_GPIO, lbp2900_gpio_init, ARRAY_SIZE(lbp2900_gpio_init), NULL, 0);
 	lbp2900_wait_ready(state->ops);
